generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cafe {
  id                            String                     @id @default(cuid())
  name                          String
  slug                          String                     @unique
  businessType                  BusinessType               @default(CAFE)
  loyaltyMode                   LoyaltyMode                @default(STAMPS)
  restaurantCategory            RestaurantCategory?
  pointsPerHundred              Decimal                    @default(10) @db.Decimal(10, 4)
  pointsRewards                 PointsReward[]
  pointsTransactions            PointsTransaction[]
  proposedBillingPeriod         BillingPeriod?
  storeLimit                    Int                        @default(1)
  spendingTrackingEnabled       Boolean                    @default(true)
  instagramUrl                  String?
  logoUrl                       String?
  theme                         CafeTheme                  @default(COFFEE_CLASSIC)
  primaryColor                  String                     @default("#8e6045")
  secondaryColor                String                     @default("#d6b08c")
  backgroundColor               String                     @default("#0c0c0c")
  dashboardTheme                CafeTheme?
  dashboardPrimaryColor         String?
  dashboardSecondaryColor       String?
  dashboardBackgroundColor      String?
  dashboardPaletteOverride      Json?
  rewardTarget                  Int                        @default(7)
  rewardName                    String                     @default("Free Drink")
  rewardDescription             String?
  minimumPurchaseAmount         Decimal?                   @db.Decimal(10, 2)
  eligiblePurchaseDescription   String?
  timezone                      String                     @default("Africa/Cairo")
  birthdayRewardsEnabled        Boolean                    @default(false)
  birthdayRewardName            String?                    @default("Birthday Reward")
  birthdayRewardDescription     String?
  birthdayPurchaseRequirement   String?
  birthdayValidityDays          Int                        @default(2)
  birthdayReminderEnabled       Boolean                    @default(true)
  birthdayReminderDaysBefore    Int                        @default(2)
  birthdayDayMessageEnabled     Boolean                    @default(true)
  birthdayFriendDiscountEnabled Boolean                    @default(false)
  birthdayOneFriendDiscount     Int                        @default(10)
  birthdayGroupDiscount         Int                        @default(20)
  isActive                      Boolean                    @default(true)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  lastPaymentAt                 DateTime?
  monthlyPrice                  Decimal?                   @db.Decimal(10, 2)
  nextReminderAt                DateTime?
  reminderSentAt                DateTime?
  subscriptionEndsAt            DateTime?
  subscriptionStartedAt         DateTime?
  subscriptionStatus            SubscriptionStatus         @default(TRIAL)
  trialEndsAt                   DateTime?
  trialStartedAt                DateTime?
  feedbackEnabled               Boolean?
  feedbackRewardEnabled         Boolean                    @default(true)
  googleReviewUrl               String?
  customers                     Customer[]
  locations                     CafeLocation[]
  reviews                       CustomerReview[]
  feedbacks                     CustomerFeedback[]
  transactions                  StampTransaction[]
  birthdayRedemptions           BirthdayRewardRedemption[]
  birthdayMessageSends          BirthdayMessageSend[]
  user                          User?
  payments                      Payment[]
  cashiers                      User[]                     @relation("CafeCashiers")
  staff                         User[]                     @relation("CafeStaff")

  @@index([subscriptionStatus])
  @@index([trialEndsAt])
  @@index([subscriptionEndsAt])
}

model CafeLocation {
  id        String     @id @default(cuid())
  cafeId    String
  name      String
  archivedAt DateTime?
  cafe      Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  pointsTransactions PointsTransaction[]
  pointsRewards PointsRewardLocation[]
  members   Customer[] @relation("CustomerJoinLocation")
  cashiers  User[] @relation("CashierLocation")
  transactions StampTransaction[] @relation("TransactionLocation")

  @@unique([cafeId, id])
  @@unique([cafeId, name])
}

model Payment {
  id        String   @id @default(cuid())
  cafeId    String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([paidAt])
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id                   String                     @id @default(cuid())
  memberNumber         String
  name                 String
  phone                String?
  instagram            String?
  birthday             DateTime
  pointsBalance        Decimal                    @default(0) @db.Decimal(18, 6)
  pointsTransactions   PointsTransaction[]
  stamps               Int                        @default(0)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  publicToken          String                     @unique
  cafeId               String
  cafe                 Cafe                       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  joinLocationId       String?
  joinLocation         CafeLocation?              @relation("CustomerJoinLocation", fields: [cafeId, joinLocationId], references: [cafeId, id], onDelete: NoAction)
  review               CustomerReview?
  feedbackRewardedAt   DateTime?
  privacyAcceptedAt DateTime?
  privacyVersion String?
  marketingConsentAt DateTime?
  marketingWithdrawnAt DateTime?
  pendingFeedbackBonus Boolean                    @default(false)
  rewardEarnedAt       DateTime?
  feedbacks            CustomerFeedback[]
  transactions         StampTransaction[]
  birthdayRedemptions  BirthdayRewardRedemption[]
  birthdayMessageSends BirthdayMessageSend[]

  @@unique([cafeId, id])
  @@unique([cafeId, phone])
  @@unique([cafeId, instagram])
  @@unique([cafeId, memberNumber])
  @@index([cafeId])
  @@index([cafeId, name])
  @@index([cafeId, joinLocationId])
}

model BirthdayRewardRedemption {
  id         String   @id @default(cuid())
  customerId String
  cafeId     String
  year       Int
  redeemedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([customerId, year])
  @@index([cafeId, year])
  @@index([cafeId, redeemedAt])
}

model BirthdayMessageSend {
  id          String   @id @default(cuid())
  customerId  String
  cafeId      String
  year        Int
  messageType String
  sentAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([customerId, year, messageType])
  @@index([cafeId, year])
  @@index([cafeId, sentAt])
}

model CustomerReview {
  id         String   @id @default(cuid())
  rating     Int
  cafeId     String
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([cafeId, createdAt])
}

model CustomerFeedback {
  id         String   @id @default(cuid())
  comment    String
  cafeId     String
  customerId String
  createdAt  DateTime @default(now())

  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([customerId])
  @@index([cafeId, createdAt])
}

model StampTransaction {
  purchaseAmount Decimal? @db.Decimal(12, 2)
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  customerId  String
  type        StampType
  description String?
  userId      String?
  cafeId      String?
  locationId  String?

  cafe     Cafe?    @relation(fields: [cafeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  location CafeLocation? @relation("TransactionLocation", fields: [cafeId, locationId], references: [cafeId, id], onDelete: NoAction)

  @@index([cafeId])
  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
  @@index([cafeId, createdAt])
  @@index([userId, createdAt])
  @@index([cafeId, type, createdAt])
  @@index([cafeId, locationId])
}

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cafeId        String?            @unique
  cashierCafeId String?
  cashierLocationId String?
  staffCafeId   String?
  isEnabled     Boolean            @default(true)
  role          UserRole           @default(CAFE_ADMIN)
  transactions  StampTransaction[]
  accounts      Account[]
  sessions      Session[]
  cafe          Cafe?              @relation(fields: [cafeId], references: [id])
  cashierCafe   Cafe?              @relation("CafeCashiers", fields: [cashierCafeId], references: [id], onDelete: SetNull)
  staffCafe     Cafe?              @relation("CafeStaff", fields: [staffCafeId], references: [id], onDelete: SetNull)

  @@index([cafeId])
  cashierLocation CafeLocation? @relation("CashierLocation", fields: [cashierLocationId], references: [id], onDelete: SetNull)

  @@index([cashierCafeId])
  @@index([cashierLocationId])
  @@index([staffCafeId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum BusinessType {
  CAFE
  BARBERSHOP
  VAPE
  OTHER
  RESTAURANT
}

enum CafeTheme {
  COFFEE_CLASSIC
  MODERN_MINIMAL
  DARK_LUXURY
  MEDITERRANEAN_BLUE
  ORGANIC
  RED_ORANGE_LIGHT
  RED_ORANGE_DARK
}

enum StampType {
  ADD
  REDEEM
  BIRTHDAY_REDEEM
}

enum UserRole {
  SUPER_ADMIN
  CAFE_ADMIN
  CASHIER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum LoyaltyMode {
  STAMPS
  POINTS
}

enum RestaurantCategory {
  SUSHI
  PIZZA
  FRIED_CHICKEN
  BURGER
  HEALTHY_FOOD
  OTHER
}

enum PointsTransactionKind {
  PURCHASE
  REDEMPTION
  REFUND
}

model PointsReward {
  id          String   @id @default(cuid())
  cafeId      String
  name        String
  description String?
  conditions  String?
  photoUrl    String?
  cost        Decimal  @db.Decimal(18, 6)
  enabled     Boolean  @default(false)
  expiresAt   DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Restrict)
  locations   PointsRewardLocation[]
  transactions PointsTransaction[]

  @@unique([cafeId, id])
  @@index([cafeId, archivedAt])
}

model PointsRewardLocation {
  cafeId     String
  rewardId   String
  locationId String
  reward     PointsReward @relation(fields: [cafeId, rewardId], references: [cafeId, id], onDelete: Cascade)
  location   CafeLocation @relation(fields: [cafeId, locationId], references: [cafeId, id], onDelete: Restrict)

  @@id([cafeId, rewardId, locationId])
}

model PointsTransaction {
  id               String                @id @default(cuid())
  cafeId           String
  customerId       String
  locationId       String
  actorId          String
  actorName        String
  kind             PointsTransactionKind
  delta            Decimal               @db.Decimal(18, 6)
  balanceAfter     Decimal               @db.Decimal(18, 6)
  amount           Decimal?              @db.Decimal(12, 2)
  pointsPerHundred Decimal?              @db.Decimal(10, 4)
  receipt          String?
  rewardId         String?
  rewardName       String?
  rewardSnapshot   Json?
  purchaseId       String?
  reason           String?
  requestId        String
  requestHash      String
  createdAt        DateTime              @default(now())
  cafe             Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Restrict)
  customer         Customer              @relation(fields: [cafeId, customerId], references: [cafeId, id], onDelete: Restrict)
  location         CafeLocation          @relation(fields: [cafeId, locationId], references: [cafeId, id], onDelete: Restrict)
  reward           PointsReward?         @relation(fields: [cafeId, rewardId], references: [cafeId, id], onDelete: Restrict)
  purchase         PointsTransaction?    @relation("PurchaseRefunds", fields: [cafeId, purchaseId], references: [cafeId, id], onDelete: Restrict)
  refunds          PointsTransaction[]   @relation("PurchaseRefunds")

  @@unique([cafeId, id])
  @@unique([cafeId, requestId])
  @@unique([cafeId, locationId, receipt])
  @@index([cafeId, customerId, createdAt])
  @@index([cafeId, createdAt])
  @@index([cafeId, purchaseId])
}
