generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cafe {
  id                          String             @id @default(cuid())
  name                        String
  slug                        String             @unique
  businessType                BusinessType       @default(CAFE)
  logoUrl                     String?
  theme                       CafeTheme          @default(COFFEE_CLASSIC)
  primaryColor                String             @default("#8e6045")
  secondaryColor              String             @default("#d6b08c")
  backgroundColor             String             @default("#0c0c0c")
  rewardTarget                Int                @default(7)
  rewardName                  String             @default("Free Drink")
  rewardDescription           String?
  minimumPurchaseAmount       Decimal?           @db.Decimal(10, 2)
  eligiblePurchaseDescription String?
  isActive                    Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  lastPaymentAt               DateTime?
  monthlyPrice                Decimal?           @db.Decimal(10, 2)
  nextReminderAt              DateTime?
  reminderSentAt              DateTime?
  subscriptionEndsAt          DateTime?
  subscriptionStartedAt       DateTime?
  subscriptionStatus          SubscriptionStatus @default(TRIAL)
  trialEndsAt                 DateTime?
  trialStartedAt              DateTime?
  googleReviewUrl             String?
  customers                   Customer[]
  reviews                     CustomerReview[]
  feedbacks                   CustomerFeedback[]
  transactions                StampTransaction[]
  birthdayRedemptions         BirthdayRewardRedemption[]
  user                        User?

  @@index([subscriptionStatus])
  @@index([trialEndsAt])
  @@index([subscriptionEndsAt])
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id                 String             @id @default(cuid())
  memberNumber       String
  name               String
  phone              String
  birthday           DateTime
  stamps             Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  publicToken        String             @unique
  cafeId             String
  cafe               Cafe               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  review             CustomerReview?
  feedbackRewardedAt DateTime?
  rewardEarnedAt     DateTime?
  feedbacks          CustomerFeedback[]
  transactions       StampTransaction[]
  birthdayRedemptions BirthdayRewardRedemption[]

  @@unique([cafeId, phone])
  @@unique([cafeId, memberNumber])
  @@index([cafeId])
  @@index([cafeId, name])
}

model BirthdayRewardRedemption {
  id         String   @id @default(cuid())
  customerId String
  cafeId     String
  year       Int
  redeemedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([customerId, year])
  @@index([cafeId, year])
  @@index([cafeId, redeemedAt])
}

model CustomerReview {
  id         String   @id @default(cuid())
  rating     Int
  cafeId     String
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([cafeId, createdAt])
}

model CustomerFeedback {
  id         String   @id @default(cuid())
  comment    String
  cafeId     String
  customerId String
  createdAt  DateTime @default(now())

  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([customerId])
  @@index([cafeId, createdAt])
}

model StampTransaction {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  customerId  String
  type        StampType
  description String?
  userId      String?
  cafeId      String?

  cafe        Cafe?     @relation(fields: [cafeId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cafeId])
  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cafeId        String?            @unique
  role          UserRole           @default(CAFE_ADMIN)
  transactions  StampTransaction[]
  accounts      Account[]
  sessions      Session[]
  cafe          Cafe?              @relation(fields: [cafeId], references: [id])

  @@index([cafeId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum BusinessType {
  CAFE
  BARBERSHOP
}

enum CafeTheme {
  COFFEE_CLASSIC
  MODERN_MINIMAL
  DARK_LUXURY
  MEDITERRANEAN_BLUE
  ORGANIC
}

enum StampType {
  ADD
  REDEEM
}

enum UserRole {
  SUPER_ADMIN
  CAFE_ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}
